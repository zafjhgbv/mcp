# ===========================================  
# MCP Server with Deep Research 配置文件
# ===========================================  
  
# AI模型配置  
# 用于关键词生成和报告撰写的主要AI模型  
DeepSearchModel=your_model_name
  
# 搜索引擎配置  
# 支持的搜索引擎类型: duckduckgo (当前主要支持)
SearchEngine=duckduckgo
  
# 并发搜索配置  
# 最大并发搜索数量，建议不超过10以避免API限制  
MaxSearchList=8
  
# 搜索广度默认值  
# 当用户未指定SearchBroadness时使用的默认值  
SearchBroadnessDefault=10
  
# ===========================================  
# OpenAI API配置  
# ===========================================  
  
# OpenAI API密钥 - 请替换为您的实际API密钥
OPENAI_API_KEY=your_openai_api_key
  
# OpenAI API基础URL，支持自定义端点  
OPENAI_BASE_URL=your_openai_base_url
  
# ===========================================  
# 文件存储配置  
# ===========================================  
  
# 报告保存目录（相对于服务器根目录）  
REPORT_SAVE_PATH=file/document
  
# ===========================================  
# 性能和超时配置  
# ===========================================  
  
# AI模型调用超时时间（秒）  
AI_MODEL_TIMEOUT=60
  
# 搜索API调用超时时间（秒）  
SEARCH_API_TIMEOUT=30
  
# 最大token限制  
MAX_TOKENS=4000
  
# ===========================================  
# 日志配置  
# ===========================================  
  
# 日志级别: DEBUG, INFO, WARNING, ERROR  
LOG_LEVEL=INFO
  
# 是否启用详细日志输出  
VERBOSE_LOGGING=true
  
# ===========================================  
# 代理配置（可选）  
# ===========================================  
  
# HTTP代理配置（如果需要）  
# HTTP_PROXY=http://proxy.example.com:8080  
# HTTPS_PROXY=https://proxy.example.com:8080  
  
# ===========================================  
# 高级配置  
# ===========================================  
  
# 搜索结果每页数量  
SEARCH_RESULTS_PER_PAGE=5
  
# 重试配置  
MAX_RETRIES=3
RETRY_DELAY=1

# ===========================================  
# MCP 服务器配置  
# ===========================================  

# 服务器主机地址
MCP_HOST=127.0.0.1

# 服务器端口
MCP_PORT=8000

# ===========================================  
# Jira-Confluence-Dify 同步配置  
# ===========================================  

# Atlassian 配置（Jira + Confluence 共用）
ATLASSIAN_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira 配置
JIRA_PROJECT_KEY=PROJ
JIRA_SINCE_DAYS=-30d

# Confluence 配置
CONFLUENCE_SPACE_KEY=TEAM
CONFLUENCE_SINCE_DAYS=30

# Dify 配置
DIFY_API_KEY=your-dify-api-key
DIFY_API_URL=https://api.dify.ai/v1
DIFY_DATASET_ID=your-dataset-id

# 数据库配置（可选，默认使用 SQLite）
# DATABASE_URL=sqlite:///sync_database.db
# 如果需要使用 PostgreSQL 或 MySQL，取消注释并配置：
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname